{
  "description": "Enforce one Current Flow Codex chat per branch and linked worktree.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/codex/session-start.mjs\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; node (Join-Path $root 'scripts/codex/session-start.mjs')\"",
            "statusMessage": "Claiming an isolated Current Flow workspace",
            "timeout": 10,
            "additionalContextLimit": 1000
          }
        ]
      }
    ]
  }
}
