ALCHEMY_ENV=development
ALCHEMY_API_HOST=0.0.0.0
ALCHEMY_API_PORT=8000
WEB_CONCURRENCY=1
ALCHEMY_GRACEFUL_SHUTDOWN_SECONDS=30
ALCHEMY_LOG_LEVEL=INFO
ALCHEMY_ALLOWED_ORIGINS=["http://localhost:5173"]
ALCHEMY_MAX_REQUEST_BODY_BYTES=1048576
ALCHEMY_REQUEST_TIMEOUT_SECONDS=30
# CURRENT_EDGE_ORIGIN_TOKEN is a production secret shared only with the Cloudflare API gateway.
# ALCHEMY_ORIGIN_TOKEN remains a supported deployment alias during rotation.
# CURRENT_EDGE_ORIGIN_TOKEN_SECONDARY is a temporary Render-only rotation slot.
# ALCHEMY_REQUIRE_EDGE_ORIGIN_TOKEN=0
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-local-password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=20
NEO4J_CONNECTION_ACQUISITION_TIMEOUT_SECONDS=5
NEO4J_CONNECTION_TIMEOUT_SECONDS=10
NEO4J_MAX_CONNECTION_LIFETIME_SECONDS=1800
NEO4J_LIVENESS_CHECK_TIMEOUT_SECONDS=30
NEO4J_MAX_TRANSACTION_RETRY_TIME_SECONDS=15
NEO4J_QUERY_TIMEOUT_SECONDS=15
PUBCHEM_USER_AGENT=CurrentAlchemy/0.1 (replace-with-project-contact)
EXTERNAL_REQUEST_TIMEOUT_SECONDS=20
EXTERNAL_REQUEST_MIN_INTERVAL_MS=250
ALCHEMY_DATA_ROOT=var/alchemy-data
ALCHEMY_MAX_AUTODOWNLOAD_BYTES=2147483648
ALCHEMY_DOWNLOAD_USER_AGENT=CurrentAlchemy-DataEngineering/0.2 (https://current-flow.net)
