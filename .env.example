# Alchemy defaults to deterministic local fixtures and performs no network requests.
VITE_ALCHEMY_DATA_MODE=demo

# Used only after the backend-owned OpenAPI contract has been integrated and a client generated.
VITE_ALCHEMY_API_BASE_URL=http://localhost:8000
VITE_ALCHEMY_REQUEST_TIMEOUT_MS=10000

# Local Alchemy API/Neo4j defaults used by Compose. Replace the password before startup.
ALCHEMY_ENV=development
ALCHEMY_LOG_LEVEL=INFO
ALCHEMY_ALLOWED_ORIGINS=["http://localhost:5173"]
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-local-password
NEO4J_DATABASE=neo4j
PUBCHEM_USER_AGENT=CurrentAlchemy/0.1 (replace-with-project-contact)
EXTERNAL_REQUEST_TIMEOUT_SECONDS=20
EXTERNAL_REQUEST_MIN_INTERVAL_MS=250
ALCHEMY_DATA_ROOT=var/alchemy-data
ALCHEMY_MAX_AUTODOWNLOAD_BYTES=2147483648
ALCHEMY_DOWNLOAD_USER_AGENT=CurrentAlchemy-DataEngineering/0.2 (https://current-flow.net)

# `npm run workspace:alchemy -- up` sets unique values for each Codex chat.
# These defaults preserve direct `docker compose` behavior outside a managed worktree.
COMPOSE_PROJECT_NAME=current-flow
CURRENT_FLOW_API_PORT=8000
CURRENT_FLOW_NEO4J_HTTP_PORT=7474
CURRENT_FLOW_NEO4J_BOLT_PORT=7687
