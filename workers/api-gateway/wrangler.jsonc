{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "current-flow-api-gateway",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "ORIGIN_BASE_URL": "https://current-flow-alchemy-api.onrender.com",
    "ALLOWED_ORIGINS": "https://current-flow.net,https://www.current-flow.net",
  },
}
