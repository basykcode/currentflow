{
  "name": "current-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "volta": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "check": "npm run toolchain:check && npm run type-check && npm run lint && npm run test:unit && npm run workspace:test && npm run gateway:test && npm run commentary:validate && npm run transitions:validate && npm run build",
    "toolchain:check": "node scripts/toolchain/verify.mjs",
    "gateway:test": "node --test workers/api-gateway/test/*.spec.mjs",
    "gateway:deploy": "wrangler deploy --config workers/api-gateway/wrangler.jsonc",
    "workspace:status": "node scripts/codex/workspace.mjs status",
    "workspace:doctor": "node scripts/codex/workspace.mjs doctor",
    "workspace:dev": "node scripts/codex/workspace.mjs dev",
    "workspace:alchemy": "node scripts/codex/workspace.mjs alchemy",
    "workspace:release": "node scripts/codex/workspace.mjs release",
    "workspace:test": "node --test scripts/codex/*.spec.mjs",
    "transitions:prepare": "node scripts/transitions/prepare.mjs",
    "transitions:scaffold-drafts": "node scripts/transitions/public.mjs scaffold-drafts",
    "transitions:build-public": "node scripts/transitions/public.mjs build",
    "transitions:validate": "node scripts/transitions/public.mjs validate-complete",
    "commentary:inventory": "node scripts/commentary/pipeline.mjs inventory",
    "commentary:normalize": "node scripts/commentary/pipeline.mjs normalize",
    "commentary:build-digests": "node scripts/commentary/pipeline.mjs build-digests",
    "commentary:build-packets": "node scripts/commentary/pipeline.mjs build-packets",
    "commentary:coverage": "node scripts/commentary/pipeline.mjs coverage",
    "commentary:prepare": "node scripts/commentary/pipeline.mjs prepare",
    "commentary:generate-drafts": "node scripts/commentary/generate-drafts.mjs",
    "commentary:build-public": "node scripts/commentary/public.mjs build",
    "commentary:validate": "node scripts/commentary/public.mjs validate-complete",
    "commentary:review": "node scripts/commentary/public.mjs review",
    "commentary:check": "npm run commentary:prepare && npm run commentary:generate-drafts && npm run commentary:build-public && npm run commentary:validate && npm run commentary:review",
    "prompt-lab:verify-sources": "node scripts/gene-keys-prompt-lab/publish-sources.mjs --dry-run",
    "prompt-lab:publish-sources": "node scripts/gene-keys-prompt-lab/publish-sources.mjs",
    "alchemy:up": "docker compose up -d --build neo4j alchemy-api",
    "alchemy:down": "docker compose down",
    "alchemy:logs": "docker compose logs -f alchemy-api neo4j",
    "alchemy:migrate": "uv --directory services/alchemy-api run alchemy db migrate",
    "alchemy:seed": "uv --directory services/alchemy-api run alchemy data seed-demo",
    "alchemy:check": "uv --directory services/alchemy-api run alchemy check",
    "alchemy:openapi": "uv --directory services/alchemy-api run alchemy openapi export",
    "alchemy:types": "openapi-typescript contracts/alchemy-openapi.json -o src/features/alchemy/api/generated/schema.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "astronomy-engine": "2.1.19",
    "lunar-javascript": "1.7.7",
    "openapi-fetch": "0.17.0",
    "pinia": "3.0.4",
    "vue": "3.5.40",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tsconfig/node22": "22.0.5",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.10.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "5.8.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "vue-tsc": "3.3.8",
    "wrangler": "4.126.0"
  }
}
