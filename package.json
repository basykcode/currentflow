{
  "name": "current-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "check": "npm run type-check && npm run lint && npm run test:unit && npm run workspace:test && npm run build",
    "workspace:status": "node scripts/codex/workspace.mjs status",
    "workspace:doctor": "node scripts/codex/workspace.mjs doctor",
    "workspace:dev": "node scripts/codex/workspace.mjs dev",
    "workspace:alchemy": "node scripts/codex/workspace.mjs alchemy",
    "workspace:release": "node scripts/codex/workspace.mjs release",
    "workspace:test": "node --test scripts/codex/*.spec.mjs",
    "alchemy:up": "docker compose up -d --build neo4j alchemy-api",
    "alchemy:down": "docker compose down",
    "alchemy:logs": "docker compose logs -f alchemy-api neo4j",
    "alchemy:migrate": "uv --directory services/alchemy-api run alchemy db migrate",
    "alchemy:seed": "uv --directory services/alchemy-api run alchemy data seed-demo",
    "alchemy:check": "uv --directory services/alchemy-api run alchemy check",
    "alchemy:openapi": "uv --directory services/alchemy-api run alchemy openapi export",
    "alchemy:types": "openapi-typescript contracts/alchemy-openapi.json -o src/features/alchemy/api/generated/schema.ts"
  },
  "dependencies": {
    "lunar-javascript": "^1.7.7",
    "openapi-fetch": "^0.17.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.16.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.30.1",
    "eslint-plugin-vue": "^10.2.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.1"
  }
}
